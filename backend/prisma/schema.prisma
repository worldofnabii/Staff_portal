generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hospital {
  id            String    @id @default(uuid())
  name          String
  address       String
  licenseNumber String    @unique
  createdAt     DateTime  @default(now())

  staff         Staff[]
  patients      Patient[]
  visits        AntenatalVisit[]
  investigations Investigation[]
  preventativeCare PreventativeCare[]
  appointments  Appointment[]
  prescriptions Prescription[]
}

model Staff {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  password         String
  role             String   // Admin, Doctor, Nurse
  mustChangePassword Boolean @default(false)
  
  hospitalId       String
  hospital         Hospital @relation(fields: [hospitalId], references: [id])

  visits           AntenatalVisit[]
  investigations   Investigation[]
  preventativeCare PreventativeCare[]
  prescriptions    Prescription[]
}

model Patient {
  id               String    @id // Used for QR code
  name             String
  email            String    @unique
  password         String
  bloodGroup       String?
  edd              DateTime?
  emergencyContact String?

  hospitalId       String
  hospital         Hospital @relation(fields: [hospitalId], references: [id])

  // Demographics/NOK
  nin              String?
  age              Int?
  village          String?
  parish           String?
  district         String?
  occupation       String?
  religion         String?
  education        String?
  maritalStatus    String?
  nokName          String?
  nokPhone         String?
  nokRelationship  String?
  nokAddress       String?

  // Relations
  medicalHistory        MedicalHistory?
  historicalPregnancies HistoricalPregnancy[]
  visits                AntenatalVisit[]
  investigations        Investigation[]
  preventativeCare      PreventativeCare[]
  carePlan              CarePlan?
  appointments          Appointment[]
  prescriptions         Prescription[]
  medicationLogs        MedicationLog[]
}

model MedicalHistory {
  id                   String  @id @default(cuid())
  patientId            String  @unique
  patient              Patient @relation(fields: [patientId], references: [id])
  gravida              Int?
  para                 Int?
  abortions            Int?
  lmp                  DateTime?
  lengthOfMenses       String?
  flowAmount           String?
  familyPlanningMethod String?
  stopReason           String?
  hivStatus          Boolean @default(false)
  cardiacDisease     Boolean @default(false)
  kidneyDisease      Boolean @default(false)
  hypertension       Boolean @default(false)
  tb                 Boolean @default(false)
  asthma             Boolean @default(false)
  sickleCell         Boolean @default(false)
  epilepsy           Boolean @default(false)
  diabetes           Boolean @default(false)
  previousCSections  Int?
  dAndC              Boolean @default(false)
  ectopicPregnancies Int?
  pph                Boolean @default(false)
  pelvicFractures    Boolean @default(false)
  bloodTransfusions  Boolean @default(false)
  smoking            Boolean @default(false)
  alcohol            Boolean @default(false)
  gbvRisk            Boolean @default(false)
  familyTwins        Boolean @default(false)
  familyDiabetes     Boolean @default(false)
  familyCongenital   Boolean @default(false)
}

model HistoricalPregnancy {
  id            String  @id @default(cuid())
  patientId     String
  patient       Patient @relation(fields: [patientId], references: [id])
  year          String?
  gestation     String?
  deliveryType  String?
  complications String?
  childOutcome  String?
  weight        Float?
}

model AntenatalVisit {
  id             String   @id @default(cuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id])
  recordedById   String
  recordedBy     Staff    @relation(fields: [recordedById], references: [id])
  hospitalId     String
  hospital       Hospital @relation(fields: [hospitalId], references: [id])
  createdAt      DateTime @default(now())
  complaints      String?
  gestationalAge  String?
  complications   String?
  bloodPressure   String?
  weight          Float?
  height          Float?
  pulse           Int?
  temp            Float?
  bmi             Float?
  muac            Float?
  nutritionalStatus String?
  generalExam     String?
  sfHeight        Float?
  vaginalExam     String?
  fetalHeartRate  Float?
  bloodSugar      Float?
  doctorNotes     String?
}

model Investigation {
  id             String   @id @default(cuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id])
  recordedById   String
  recordedBy     Staff    @relation(fields: [recordedById], references: [id])
  hospitalId     String
  hospital       Hospital @relation(fields: [hospitalId], references: [id])
  createdAt      DateTime @default(now())
  testType       String
  category       String?
  result         String
  date           DateTime @default(now())
  attachmentUrl  String?
}

model PreventativeCare {
  id             String   @id @default(cuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id])
  recordedById   String
  recordedBy     Staff    @relation(fields: [recordedById], references: [id])
  hospitalId     String
  hospital       Hospital @relation(fields: [hospitalId], references: [id])
  createdAt      DateTime @default(now())
  supplementType String
  date           DateTime @default(now())
}

model Prescription {
  id             String   @id @default(cuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id])
  prescribedById String
  prescribedBy   Staff    @relation(fields: [prescribedById], references: [id])
  hospitalId     String
  hospital       Hospital @relation(fields: [hospitalId], references: [id])
  createdAt      DateTime @default(now())

  medication     String
  dosage         String
  frequency      String
  duration       String
  notes          String?
  isActive       Boolean  @default(true)

  logs           MedicationLog[]
}

model MedicationLog {
  id             String   @id @default(cuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id])
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  takenAt        DateTime @default(now())
  notes          String?
}

model CarePlan {
  id                        String  @id @default(cuid())
  patientId                 String  @unique
  patient                   Patient @relation(fields: [patientId], references: [id])
  feedingOption             String?
  postpartumContraception   String?
  transportLogistics        String?
  maternityWaitingHome      Boolean @default(false)
  deliveryPlan              String?
}

model Appointment {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  date      DateTime
  purpose   String?
  status    String   @default("Scheduled")
  createdAt DateTime @default(now())
}
